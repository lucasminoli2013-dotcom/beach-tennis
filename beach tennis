<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Beach Radar</title>

    <style>
        :root {
            --bg: #08111f;
            --card: #111d2e;
            --card2: #17263a;
            --border: #263951;

            --green: #20d68a;
            --green-dark: #12a96b;

            --text: #f5f7fa;
            --muted: #91a1b7;

            --red: #ef4444;
            --yellow: #f59e0b;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            background: var(--bg);
            color: var(--text);
            font-family: Arial, Helvetica, sans-serif;
        }

        header {
            position: sticky;
            top: 0;
            z-index: 10;

            padding: 18px;

            background: rgba(8, 17, 31, .95);
            border-bottom: 1px solid var(--border);

            backdrop-filter: blur(10px);
        }

        .header {
            max-width: 900px;
            margin: auto;

            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-icon {
            width: 45px;
            height: 45px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 13px;

            background: linear-gradient(
                135deg,
                var(--green),
                #159de0
            );

            font-size: 23px;
        }

        .logo h1 {
            font-size: 20px;
        }

        .logo p {
            margin-top: 3px;
            font-size: 12px;
            color: var(--muted);
        }

        .gps {
            display: flex;
            align-items: center;
            gap: 7px;

            font-size: 12px;
            color: var(--muted);
        }

        .gps-dot {
            width: 9px;
            height: 9px;

            border-radius: 50%;

            background: var(--yellow);
        }

        .gps-dot.active {
            background: var(--green);

            box-shadow:
                0 0 12px
                rgba(32, 214, 138, .8);
        }

        main {
            max-width: 900px;
            margin: auto;

            padding: 25px 16px 70px;
        }

        .card {
            background: var(--card);

            border: 1px solid var(--border);
            border-radius: 18px;

            padding: 22px;

            margin-bottom: 18px;
        }

        .status {
            background:
                linear-gradient(
                    145deg,
                    #16273e,
                    #101b2c
                );
        }

        .status-label {
            font-size: 12px;
            color: var(--muted);
            margin-bottom: 6px;
        }

        .status-title {
            font-size: 24px;
            font-weight: bold;
        }

        .status-description {
            margin-top: 8px;
            color: var(--muted);
            font-size: 14px;
        }

        .playing {
            display: none;

            margin-top: 22px;

            text-align: center;

            padding: 25px;

            border-radius: 15px;

            background:
                rgba(32, 214, 138, .08);

            border:
                1px solid
                rgba(32, 214, 138, .25);
        }

        .playing.active {
            display: block;
        }

        .playing-icon {
            font-size: 55px;
            margin-bottom: 8px;
        }

        .playing h2 {
            font-size: 20px;
            margin-bottom: 7px;
        }

        .playing p {
            color: var(--muted);
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 14px;
        }

        .stat {
            background: var(--card);

            border: 1px solid var(--border);
            border-radius: 16px;

            padding: 20px;
        }

        .stat-number {
            color: var(--green);
            font-size: 30px;
            font-weight: bold;
        }

        .stat-name {
            margin-top: 5px;
            color: var(--muted);
            font-size: 13px;
        }

        .section-title {
            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 10px;

            margin-bottom: 18px;
        }

        .section-title h2 {
            font-size: 18px;
        }

        button {
            border: 0;
            cursor: pointer;

            border-radius: 10px;

            font-weight: bold;

            transition: .2s;
        }

        button:hover {
            transform: translateY(-1px);
        }

        .primary {
            padding: 12px 16px;

            background: var(--green);
            color: #062014;
        }

        .primary:hover {
            background: var(--green-dark);
        }

        .secondary {
            padding: 12px 16px;

            background: var(--card2);
            color: white;
        }

        .locations {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .location {
            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 15px;

            padding: 16px;

            border-radius: 14px;

            background: #0e1929;

            border: 1px solid var(--border);
        }

        .location.active {
            border-color: var(--green);

            background:
                rgba(32, 214, 138, .07);
        }

        .location-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .location-icon {
            width: 43px;
            height: 43px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 12px;

            background: var(--card2);

            font-size: 20px;
        }

        .location-name {
            font-weight: bold;
        }

        .location-meta {
            margin-top: 5px;

            color: var(--muted);

            font-size: 12px;
        }

        .distance {
            color: var(--green);

            font-size: 13px;
            font-weight: bold;

            white-space: nowrap;
        }

        .empty {
            text-align: center;

            padding: 35px 10px;

            color: var(--muted);
        }

        .empty-icon {
            font-size: 35px;
            margin-bottom: 8px;
        }

        .modal {
            position: fixed;
            inset: 0;

            z-index: 100;

            display: none;

            align-items: center;
            justify-content: center;

            padding: 18px;

            background: rgba(0, 0, 0, .7);
        }

        .modal.open {
            display: flex;
        }

        .modal-box {
            width: 100%;
            max-width: 450px;

            background: #111d2e;

            border: 1px solid var(--border);

            border-radius: 18px;

            padding: 23px;
        }

        .modal-box h2 {
            margin-bottom: 20px;
        }

        label {
            display: block;

            margin-bottom: 7px;

            color: var(--muted);

            font-size: 13px;
        }

        input,
        select {
            width: 100%;

            padding: 13px;

            margin-bottom: 16px;

            border-radius: 10px;

            border: 1px solid var(--border);

            background: #091423;

            color: white;

            outline: none;
        }

        input:focus,
        select:focus {
            border-color: var(--green);
        }

        .modal-buttons {
            display: flex;
            gap: 10px;
        }

        .modal-buttons button {
            flex: 1;
        }

        .delete {
            margin-top: 10px;

            padding: 8px 12px;

            background: transparent;

            color: var(--red);

            border: 1px solid
                rgba(239, 68, 68, .3);

            font-size: 12px;
        }

        @media (max-width: 600px) {

            .header {
                align-items: flex-start;
            }

            .gps {
                margin-top: 8px;
            }

            .status-title {
                font-size: 21px;
            }

            .location {
                align-items: flex-start;
            }

            .distance {
                font-size: 12px;
            }
        }
    </style>
</head>

<body>

<header>

    <div class="header">

        <div class="logo">

            <div class="logo-icon">
                🏓
            </div>

            <div>
                <h1>Beach Radar</h1>

                <p>
                    Jogadores perto de você
                </p>
            </div>

        </div>

        <div class="gps">

            <span
                id="gpsDot"
                class="gps-dot">
            </span>

            <span id="gpsText">
                GPS desligado
            </span>

        </div>

    </div>

</header>

<main>

    <!-- STATUS -->

    <section class="card status">

        <div class="status-label">
            STATUS ATUAL
        </div>

        <div
            id="statusTitle"
            class="status-title">

            Localizando você...

        </div>

        <div
            id="statusDescription"
            class="status-description">

            Permita o acesso à localização
            para encontrar pontos próximos.

        </div>

        <div
            id="playing"
            class="playing">

            <div class="playing-icon">
                🏓
            </div>

            <h2>
                Você está no ponto!
            </h2>

            <p id="playingName">
            </p>

        </div>

    </section>


    <!-- ESTATÍSTICAS -->

    <section class="stats">

        <div class="stat">

            <div
                id="locationsCount"
                class="stat-number">

                0

            </div>

            <div class="stat-name">
                Locais cadastrados
            </div>

        </div>

        <div class="stat">

            <div
                id="playersCount"
                class="stat-number">

                0

            </div>

            <div class="stat-name">
                Você está em um ponto
            </div>

        </div>

    </section>


    <!-- LOCAIS -->

    <section class="card">

        <div class="section-title">

            <h2>
                📍 Pontos de encontro
            </h2>

            <button
                class="primary"
                onclick="openModal()">

                + Adicionar

            </button>

        </div>

        <div
            id="locations"
            class="locations">

        </div>

    </section>

</main>


<!-- MODAL -->

<div
    id="modal"
    class="modal">

    <div class="modal-box">

        <h2>
            Adicionar local
        </h2>

        <label>
            Nome do local
        </label>

        <input
            id="name"
            type="text"
            placeholder="Ex: Arena Central">


        <label>
            Tipo
        </label>

        <select id="type">

            <option>Arena</option>
            <option>Quadra</option>
            <option>Praia</option>
            <option>Clube</option>

        </select>


        <label>
            Raio de presença
        </label>

        <input
            id="radius"
            type="number"
            value="100"
            min="20"
            max="1000">


        <div class="modal-buttons">

            <button
                class="secondary"
                onclick="closeModal()">

                Cancelar

            </button>

            <button
                class="primary"
                onclick="addLocation()">

                Adicionar

            </button>

        </div>

    </div>

</div>


<script>

    /*
    =========================================
    BEACH RADAR
    =========================================
    Funciona diretamente no GitHub Pages.

    Não precisa de:
    - PHP
    - Node.js
    - banco de dados
    - servidor próprio
    =========================================
    */


    let latitude = null;
    let longitude = null;

    let activeLocation = null;


    /*
    =========================================
    LOCAL STORAGE
    =========================================
    */

    function getLocations() {

        try {

            return JSON.parse(
                localStorage.getItem(
                    "beachRadarLocations"
                )
            ) || [];

        } catch {

            return [];

        }

    }


    function saveLocations(locations) {

        localStorage.setItem(
            "beachRadarLocations",
            JSON.stringify(locations)
        );

    }


    /*
    =========================================
    DISTÂNCIA
    =========================================
    */

    function distance(
        lat1,
        lon1,
        lat2,
        lon2
    ) {

        const R = 6371000;

        const dLat =
            (lat2 - lat1)
            * Math.PI / 180;

        const dLon =
            (lon2 - lon1)
            * Math.PI / 180;

        const a =
            Math.sin(dLat / 2) ** 2 +

            Math.cos(
                lat1 * Math.PI / 180
            ) *

            Math.cos(
                lat2 * Math.PI / 180
            ) *

            Math.sin(dLon / 2) ** 2;

        const c =
            2 *
            Math.atan2(
                Math.sqrt(a),
                Math.sqrt(1 - a)
            );

        return R * c;

    }


    /*
    =========================================
    GPS
    =========================================
    */

    function startGPS() {

        if (!navigator.geolocation) {

            setGPS(
                false,
                "GPS não disponível"
            );

            return;

        }


        setGPS(
            false,
            "Solicitando localização..."
        );


        navigator.geolocation.watchPosition(

            function(position) {

                latitude =
                    position.coords.latitude;

                longitude =
                    position.coords.longitude;


                setGPS(
                    true,
                    "GPS ativo"
                );


                checkLocations();

            },

            function(error) {

                console.log(
                    "Erro GPS:",
                    error
                );


                setGPS(
                    false,
                    "Permita a localização"
                );


                document
                    .getElementById(
                        "statusTitle"
                    )
                    .textContent =
                        "Localização desativada";

                document
                    .getElementById(
                        "statusDescription"
                    )
                    .textContent =
                        "Permita o acesso à localização do navegador.";

            },

            {
                enableHighAccuracy: true,

                maximumAge: 5000,

                timeout: 15000
            }

        );

    }


    function setGPS(active, text) {

        const dot =
            document.getElementById(
                "gpsDot"
            );

        const label =
            document.getElementById(
                "gpsText"
            );


        label.textContent = text;


        if (active) {

            dot.classList.add(
                "active"
            );

        } else {

            dot.classList.remove(
                "active"
            );

        }

    }


    /*
    =========================================
    VERIFICAR LOCAIS
    =========================================
    */

    function checkLocations() {

        if (
            latitude === null ||
            longitude === null
        ) {

            return;

        }


        const locations =
            getLocations();


        activeLocation = null;


        for (
            const location
            of locations
        ) {

            const meters =
                distance(
                    latitude,
                    longitude,
                    location.latitude,
                    location.longitude
                );


            if (
                meters <=
                location.radius
            ) {

                activeLocation = {

                    ...location,

                    distance: meters

                };

                break;

            }

        }


        update();

    }


    /*
    =========================================
    ATUALIZAR TELA
    =========================================
    */

    function update() {

        const playing =
            document.getElementById(
                "playing"
            );

        const title =
            document.getElementById(
                "statusTitle"
            );

        const description =
            document.getElementById(
                "statusDescription"
            );


        if (activeLocation) {

            playing.classList.add(
                "active"
            );


            title.textContent =
                "Você está jogando!";


            description.textContent =
                "Ponto de encontro encontrado.";


            document
                .getElementById(
                    "playingName"
                )
                .textContent =

                activeLocation.name
                +
                " • "
                +
                Math.round(
                    activeLocation.distance
                )
                +
                " m";

        } else {

            playing.classList.remove(
                "active"
            );


            title.textContent =
                "Nenhum ponto próximo";


            description.textContent =
                "Procure um dos pontos cadastrados.";

        }


        renderLocations();
        updateStats();

    }


    /*
    =========================================
    ESTATÍSTICAS
    =========================================
    */

    function updateStats() {

        const locations =
            getLocations();


        document
            .getElementById(
                "locationsCount"
            )
            .textContent =
                locations.length;


        document
            .getElementById(
                "playersCount"
            )
            .textContent =
                activeLocation
                ? "SIM"
                : "NÃO";

    }


    /*
    =========================================
    RENDERIZAR LOCAIS
    =========================================
    */

    function renderLocations() {

        const container =
            document.getElementById(
                "locations"
            );


        const locations =
            getLocations();


        if (
            locations.length === 0
        ) {

            container.innerHTML = `

                <div class="empty">

                    <div class="empty-icon">
                        📍
                    </div>

                    Nenhum local cadastrado.

                    <br>

                    Adicione um ponto para começar.

                </div>

            `;

            return;

        }


        container.innerHTML = "";


        locations.forEach(
            location => {

                let meters = null;

                let active = false;


                if (
                    latitude !== null &&
                    longitude !== null
                ) {

                    meters =
                        distance(
                            latitude,
                            longitude,
                            location.latitude,
                            location.longitude
                        );


                    active =
                        meters <=
                        location.radius;

                }


                const element =
                    document.createElement(
                        "div"
                    );


                element.className =
                    "location";


                if (active) {

                    element.classList.add(
                        "active"
                    );

                }


                let distanceText =
                    "Local salvo";


                if (meters !== null) {

                    if (meters >= 1000) {

                        distanceText =
                            (
                                meters / 1000
                            ).toFixed(1)
                            +
                            " km";

                    } else {

                        distanceText =
                            Math.round(
                                meters
                            )
                            +
                            " m";

                    }

                }


                element.innerHTML = `

                    <div class="location-info">

                        <div class="location-icon">
                            📍
                        </div>

                        <div>

                            <div class="location-name">
                                ${escapeHTML(location.name)}
                            </div>

                            <div class="location-meta">

                                ${escapeHTML(location.type)}

                                • Raio:
                                ${location.radius} m

                            </div>

                            <button
                                class="delete"
                                onclick="deleteLocation('${location.id}')">

                                Remover

                            </button>

                        </div>

                    </div>

                    <div class="distance">

                        ${distanceText}

                    </div>

                `;


                container.appendChild(
                    element
                );

            }
        );

    }


    /*
    =========================================
    SEGURANÇA DO HTML
    =========================================
    */

    function escapeHTML(text) {

        return String(text)
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");

    }


    /*
    =========================================
    MODAL
    =========================================
    */

    function openModal() {

        document
            .getElementById("modal")
            .classList
            .add("open");

    }


    function closeModal() {

        document
            .getElementById("modal")
            .classList
            .remove("open");

    }


    /*
    =========================================
    ADICIONAR LOCAL
    =========================================
    */

    function addLocation() {

        if (
            latitude === null ||
            longitude === null
        ) {

            alert(
                "Aguarde o GPS ser ativado."
            );

            return;

        }


        const name =
            document
                .getElementById("name")
                .value
                .trim();


        const type =
            document
                .getElementById("type")
                .value;


        const radius =
            Number(
                document
                    .getElementById("radius")
                    .value
            );


        if (!name) {

            alert(
                "Digite o nome do local."
            );

            return;

        }


        if (
            radius < 20 ||
            radius > 1000
        ) {

            alert(
                "O raio precisa estar entre 20 e 1000 metros."
            );

            return;

        }


        const locations =
            getLocations();


        /*
        Evita cadastrar dois
        locais praticamente no
        mesmo lugar.
        */

        for (
            const location
            of locations
        ) {

            const meters =
                distance(
                    latitude,
                    longitude,
                    location.latitude,
                    location.longitude
                );


            if (meters < 50) {

                alert(
                    "Já existe um local próximo: "
                    +
                    location.name
                );

                return;

            }

        }


        const newLocation = {

            id:
                crypto.randomUUID(),

            name:
                name,

            type:
                type,

            radius:
                radius,

            latitude:
                latitude,

            longitude:
                longitude,

            createdAt:
                new Date().toISOString()

        };


        locations.push(
            newLocation
        );


        saveLocations(
            locations
        );


        document
            .getElementById("name")
            .value = "";


        closeModal();


        checkLocations();

    }


    /*
    =========================================
    REMOVER LOCAL
    =========================================
    */

    function deleteLocation(id) {

        const locations =
            getLocations();


        const location =
            locations.find(
                item =>
                    item.id === id
            );


        if (!location) {

            return;

        }


        const confirmed =
            confirm(
                "Remover o local "
                +
                location.name
                +
                "?"
            );


        if (!confirmed) {

            return;

        }


        const updated =
            locations.filter(
                item =>
                    item.id !== id
            );


        saveLocations(
            updated
        );


        checkLocations();

    }


    /*
    =========================================
    FECHAR MODAL CLICANDO FORA
    =========================================
    */

    document
        .getElementById("modal")
        .addEventListener(
            "click",
            function(event) {

                if (
                    event.target === this
                ) {

                    closeModal();

                }

            }
        );


    /*
    =========================================
    INICIAR
    =========================================
    */

    renderLocations();

    updateStats();

    startGPS();

</script>

</body>
</html>
