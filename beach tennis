<!DOCTYPE html>
<html lang="pt-BR">
<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Beach Radar</title>

<style>

:root {
    --bg: #0b1220;
    --bg-secondary: #111a2b;
    --card: #141f32;
    --card-hover: #19263d;

    --primary: #20d68a;
    --primary-dark: #13a96b;

    --text: #f5f7fa;
    --text-secondary: #94a3b8;

    --border: #26344d;

    --danger: #ef4444;
    --warning: #f59e0b;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background: var(--bg);
    color: var(--text);
    font-family:
        Inter,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

    min-height: 100vh;
}


/* ===============================
   HEADER
================================ */

header {

    padding: 22px 20px;

    border-bottom:
        1px solid var(--border);

    background:
        rgba(11, 18, 32, 0.95);

    position: sticky;

    top: 0;

    z-index: 100;

    backdrop-filter:
        blur(12px);

}

.header-content {

    max-width: 850px;

    margin: auto;

    display: flex;

    align-items: center;

    justify-content: space-between;

}

.logo {

    display: flex;

    align-items: center;

    gap: 10px;

}

.logo-icon {

    width: 42px;
    height: 42px;

    display: flex;

    align-items: center;

    justify-content: center;

    background:
        linear-gradient(
            135deg,
            var(--primary),
            #12a8e8
        );

    border-radius: 12px;

    font-size: 22px;

}

.logo h1 {

    font-size: 20px;

    letter-spacing: -0.5px;

}

.logo span {

    color: var(--text-secondary);

    font-size: 12px;

}


/* ===============================
   CONTAINER
================================ */

.container {

    width: 100%;

    max-width: 850px;

    margin: auto;

    padding:
        28px 18px 80px;

}


/* ===============================
   STATUS
================================ */

.status-card {

    background:
        linear-gradient(
            145deg,
            #162238,
            #101a2a
        );

    border:
        1px solid var(--border);

    border-radius: 20px;

    padding: 26px;

    margin-bottom: 22px;

}

.status-top {

    display: flex;

    justify-content: space-between;

    align-items: center;

}

.status-label {

    color:
        var(--text-secondary);

    font-size: 13px;

    margin-bottom: 6px;

}

.status-title {

    font-size: 22px;

    font-weight: 700;

}

.gps-status {

    display: flex;

    align-items: center;

    gap: 7px;

    color:
        var(--text-secondary);

    font-size: 13px;

}

.dot {

    width: 9px;

    height: 9px;

    border-radius: 50%;

    background:
        var(--warning);

}

.dot.active {

    background:
        var(--primary);

    box-shadow:
        0 0 12px
        rgba(32, 214, 138, 0.8);

}


/* ===============================
   PLAYER STATUS
================================ */

.player-status {

    margin-top: 28px;

    display: none;

    text-align: center;

    padding: 28px;

    border-radius: 16px;

    background:
        rgba(32, 214, 138, 0.08);

    border:
        1px solid
        rgba(32, 214, 138, 0.25);

}

.player-status.active {

    display: block;

}

.racket {

    font-size: 62px;

    margin-bottom: 12px;

}

.player-status h2 {

    font-size: 20px;

    margin-bottom: 8px;

}

.player-status p {

    color:
        var(--text-secondary);

}


/* ===============================
   STATS
================================ */

.stats {

    display: grid;

    grid-template-columns:
        repeat(2, 1fr);

    gap: 14px;

    margin-bottom: 22px;

}

.stat {

    background:
        var(--card);

    border:
        1px solid var(--border);

    border-radius: 16px;

    padding: 20px;

}

.stat-number {

    font-size: 28px;

    font-weight: 700;

    color:
        var(--primary);

}

.stat-label {

    margin-top: 4px;

    font-size: 13px;

    color:
        var(--text-secondary);

}


/* ===============================
   SECTION
================================ */

.section {

    background:
        var(--card);

    border:
        1px solid var(--border);

    border-radius: 18px;

    padding: 22px;

    margin-bottom: 20px;

}

.section-header {

    display: flex;

    align-items: center;

    justify-content: space-between;

    margin-bottom: 18px;

}

.section h2 {

    font-size: 18px;

}


/* ===============================
   BUTTON
================================ */

button {

    border: none;

    cursor: pointer;

    font-size: 14px;

    font-weight: 600;

    border-radius: 10px;

    transition:
        0.2s ease;

}

.btn-primary {

    background:
        var(--primary);

    color:
        #062014;

    padding:
        13px 18px;

}

.btn-primary:hover {

    background:
        var(--primary-dark);

    transform:
        translateY(-1px);

}

.btn-secondary {

    background:
        #1d2b42;

    color:
        var(--text);

    padding:
        11px 15px;

}

.btn-danger {

    background:
        transparent;

    color:
        var(--danger);

    border:
        1px solid
        rgba(239,68,68,0.3);

    padding:
        8px 12px;

}


/* ===============================
   LOCATIONS
================================ */

.location-list {

    display: flex;

    flex-direction: column;

    gap: 12px;

}

.location {

    padding: 17px;

    border-radius: 14px;

    background:
        var(--bg-secondary);

    border:
        1px solid var(--border);

    display: flex;

    align-items: center;

    justify-content: space-between;

}

.location.active {

    border-color:
        var(--primary);

    background:
        rgba(32,214,138,0.06);

}

.location-info {

    display: flex;

    align-items: center;

    gap: 13px;

}

.location-icon {

    width: 42px;

    height: 42px;

    border-radius: 12px;

    display: flex;

    align-items: center;

    justify-content: center;

    background:
        #1d2b42;

}

.location-name {

    font-weight: 600;

}

.location-meta {

    margin-top: 4px;

    font-size: 12px;

    color:
        var(--text-secondary);

}

.location-distance {

    color:
        var(--primary);

    font-size: 13px;

    font-weight: 600;

}


/* ===============================
   EMPTY STATE
================================ */

.empty {

    text-align: center;

    padding: 35px 10px;

    color:
        var(--text-secondary);

}

.empty-icon {

    font-size: 35px;

    margin-bottom: 10px;

}


/* ===============================
   MODAL
================================ */

.modal {

    position: fixed;

    inset: 0;

    background:
        rgba(0,0,0,0.65);

    display: none;

    align-items: center;

    justify-content: center;

    padding: 20px;

    z-index: 1000;

}

.modal.open {

    display: flex;

}

.modal-content {

    width: 100%;

    max-width: 450px;

    background:
        #121d30;

    border:
        1px solid var(--border);

    border-radius: 20px;

    padding: 24px;

}

.modal-content h2 {

    margin-bottom: 20px;

}

label {

    display: block;

    font-size: 13px;

    color:
        var(--text-secondary);

    margin-bottom: 7px;

}

input,
select {

    width: 100%;

    padding: 13px;

    border-radius: 10px;

    border:
        1px solid var(--border);

    background:
        #0d1626;

    color:
        white;

    margin-bottom: 16px;

    outline: none;

}

input:focus,
select:focus {

    border-color:
        var(--primary);

}

.modal-actions {

    display: flex;

    gap: 10px;

}

.modal-actions button {

    flex: 1;

}


/* ===============================
   RESPONSIVO
================================ */

@media (max-width: 600px) {

    .container {
        padding: 20px 14px 60px;
    }

    .status-card {
        padding: 20px;
    }

    .location {
        align-items: flex-start;
    }

}

</style>

</head>

<body>


<!-- HEADER -->

<header>

<div class="header-content">

<div class="logo">

<div class="logo-icon">
🏓
</div>

<div>

<h1>Beach Radar</h1>

<span>Jogadores perto de você</span>

</div>

</div>

<div class="gps-status">

<div
id="gpsDot"
class="dot">
</div>

<span id="gpsText">
Conectando GPS
</span>

</div>

</div>

</header>


<!-- CONTAINER -->

<main class="container">


<!-- STATUS -->

<section class="status-card">

<div class="status-top">

<div>

<div class="status-label">
STATUS ATUAL
</div>

<div
id="statusTitle"
class="status-title">

Localizando você...

</div>

</div>

</div>


<div
id="playerStatus"
class="player-status">

<div class="racket">
🏓
</div>

<h2>
Você está no ponto!
</h2>

<p id="activeLocationName">
</p>

</div>

</section>


<!-- STATS -->

<section class="stats">

<div class="stat">

<div
id="locationsCount"
class="stat-number">

0

</div>

<div class="stat-label">

Locais cadastrados

</div>

</div>


<div class="stat">

<div
id="playersCount"
class="stat-number">

0

</div>

<div class="stat-label">

Jogadores ativos

</div>

</div>

</section>


<!-- LOCATIONS -->

<section class="section">

<div class="section-header">

<h2>
📍 Pontos de encontro
</h2>

<button
class="btn-primary"
onclick="openModal()">

+ Adicionar

</button>

</div>


<div
id="locationsList"
class="location-list">

<div class="empty">

<div class="empty-icon">
📍
</div>

Nenhum local cadastrado.

</div>

</div>

</section>


</main>


<!-- MODAL -->

<div
id="modal"
class="modal">

<div class="modal-content">

<h2>
Adicionar local
</h2>


<label>
Nome do local
</label>

<input
id="locationName"
type="text"
placeholder="Ex: Arena Central"
/>


<label>
Tipo
</label>

<select id="locationType">

<option>
Arena
</option>

<option>
Quadra
</option>

<option>
Praia
</option>

<option>
Clube
</option>

</select>


<label>
Raio de presença
</label>

<input
id="locationRadius"
type="number"
value="100"
/>


<div class="modal-actions">

<button
class="btn-secondary"
onclick="closeModal()">

Cancelar

</button>


<button
class="btn-primary"
onclick="addLocation()">

Adicionar

</button>

</div>

</div>

</div>


<script>


/* ==========================================
   ESTADO
========================================== */

let currentLatitude = null;
let currentLongitude = null;

let activeLocation = null;


/* ==========================================
   IDENTIFICADOR ANÔNIMO
========================================== */

let playerId =
localStorage.getItem("beachPlayerId");


if (!playerId) {

    playerId =
        crypto.randomUUID();

    localStorage.setItem(
        "beachPlayerId",
        playerId
    );

}


/* ==========================================
   STORAGE
========================================== */

function getLocations() {

    return JSON.parse(

        localStorage.getItem(
            "beachLocations"
        )

    ) || [];

}


function saveLocations(locations) {

    localStorage.setItem(

        "beachLocations",

        JSON.stringify(
            locations
        )

    );

}


/* ==========================================
   HAVERSINE
========================================== */

function calculateDistance(

    lat1,
    lon1,
    lat2,
    lon2

) {

    const R = 6371000;

    const dLat =
        (lat2 - lat1)
        *
        Math.PI
        /
        180;

    const dLon =
        (lon2 - lon1)
        *
        Math.PI
        /
        180;


    const a =

        Math.sin(
            dLat / 2
        ) ** 2

        +

        Math.cos(
            lat1 *
            Math.PI /
            180
        )

        *

        Math.cos(
            lat2 *
            Math.PI /
            180
        )

        *

        Math.sin(
            dLon / 2
        ) ** 2;


    const c =

        2 *
        Math.atan2(

            Math.sqrt(a),

            Math.sqrt(1 - a)

        );


    return R * c;

}


/* ==========================================
   GPS
========================================== */

function startGPS() {

    if (!navigator.geolocation) {

        setGPSStatus(
            false,
            "GPS indisponível"
        );

        return;

    }


    navigator.geolocation.watchPosition(

        position => {

            currentLatitude =
                position.coords.latitude;

            currentLongitude =
                position.coords.longitude;


            setGPSStatus(
                true,
                "GPS ativo"
            );


            checkLocations();

        },


        error => {

            setGPSStatus(
                false,
                "Ative a localização"
            );

        },


        {

            enableHighAccuracy: true,

            maximumAge: 5000,

            timeout: 15000

        }

    );

}


function setGPSStatus(
    active,
    text
) {

    const dot =
        document.getElementById(
            "gpsDot"
        );


    const label =
        document.getElementById(
            "gpsText"
        );


    label.textContent = text;


    if (active) {

        dot.classList.add(
            "active"
        );

    }

    else {

        dot.classList.remove(
            "active"
        );

    }

}


/* ==========================================
   VERIFICAR PRESENÇA
========================================== */

function checkLocations() {

    if (
        currentLatitude === null
        ||
        currentLongitude === null
    ) {
        return;
    }


    const locations =
        getLocations();


    activeLocation = null;


    for (
        const location
        of locations
    ) {

        const distance =
            calculateDistance(

                currentLatitude,

                currentLongitude,

                location.latitude,

                location.longitude

            );


        if (
            distance <=
            location.radius
        ) {

            activeLocation = {

                ...location,

                distance

            };

            break;

        }

    }


    updateInterface();

}


/* ==========================================
   ATUALIZAR INTERFACE
========================================== */

function updateInterface() {

    const playerStatus =
        document.getElementById(
            "playerStatus"
        );


    const statusTitle =
        document.getElementById(
            "statusTitle"
        );


    if (activeLocation) {

        playerStatus
        .classList
        .add("active");


        statusTitle.textContent =
            "Você está jogando!";


        document
        .getElementById(
            "activeLocationName"
        )
        .textContent =

            activeLocation.name

            +

            " • "

            +

            Math.round(
                activeLocation.distance
            )

            +

            " m do ponto";


    }

    else {

        playerStatus
        .classList
        .remove("active");


        statusTitle.textContent =
            "Nenhum ponto próximo";

    }


    renderLocations();

    updateStats();

}


/* ==========================================
   ESTATÍSTICAS
========================================== */

function updateStats() {

    const locations =
        getLocations();


    document
    .getElementById(
        "locationsCount"
    )
    .textContent =
        locations.length;


    document
    .getElementById(
        "playersCount"
    )
    .textContent =

        activeLocation
        ? 1
        : 0;

}


/* ==========================================
   RENDERIZAR LOCAIS
========================================== */

function renderLocations() {

    const container =
        document.getElementById(
            "locationsList"
        );


    const locations =
        getLocations();


    if (
        locations.length === 0
    ) {

        container.innerHTML = `

            <div class="empty">

                <div class="empty-icon">
                    📍
                </div>

                Nenhum ponto de encontro
                cadastrado ainda.

            </div>

        `;

        return;

    }


    container.innerHTML = "";


    locations.forEach(
        location => {


            let distanceText =
                "Local salvo";


            let isActive = false;


            if (

                currentLatitude !== null

                &&

                currentLongitude !== null

            ) {

                const distance =
                    calculateDistance(

                        currentLatitude,

                        currentLongitude,

                        location.latitude,

                        location.longitude

                    );


                distanceText =

                    Math.round(distance)

                    +

                    " m";


                if (

                    distance <=
                    location.radius

                ) {

                    isActive = true;

                }

            }


            const div =
                document.createElement(
                    "div"
                );


            div.className =
                "location";


            if (isActive) {

                div.classList.add(
                    "active"
                );

            }


            div.innerHTML = `

                <div class="location-info">

                    <div class="location-icon">
                        📍
                    </div>

                    <div>

                        <div class="location-name">

                            ${location.name}

                        </div>

                        <div class="location-meta">

                            ${location.type}

                            • Raio:
                            ${location.radius} m

                        </div>

                    </div>

                </div>


                <div>

                    <div class="location-distance">

                        ${distanceText}

                    </div>

                </div>

            `;


            container.appendChild(
                div
            );

        }

    );

}


/* ==========================================
   MODAL
========================================== */

function openModal() {

    document
    .getElementById("modal")
    .classList
    .add("open");

}


function closeModal() {

    document
    .getElementById("modal")
    .classList
    .remove("open");

}


/* ==========================================
   ADICIONAR LOCAL
========================================== */

function addLocation() {

    if (

        currentLatitude === null

        ||

        currentLongitude === null

    ) {

        alert(
            "Aguarde o GPS ser ativado."
        );

        return;

    }


    const name =
        document
        .getElementById(
            "locationName"
        )
        .value
        .trim();


    const type =
        document
        .getElementById(
            "locationType"
        )
        .value;


    const radius =
        Number(

            document
            .getElementById(
                "locationRadius"
            )
            .value

        );


    if (!name) {

        alert(
            "Digite o nome do local."
        );

        return;

    }


    if (

        radius < 20

        ||

        radius > 1000

    ) {

        alert(
            "Escolha um raio entre 20 e 1000 metros."
        );

        return;

    }


    const locations =
        getLocations();


    for (
        const location
        of locations
    ) {

        const distance =
            calculateDistance(

                currentLatitude,

                currentLongitude,

                location.latitude,

                location.longitude

            );


        if (
            distance < 50
        ) {

            alert(

                "Já existe um local próximo: "

                +

                location.name

            );

            return;

        }

    }


    const newLocation = {

        id:
            crypto.randomUUID(),

        name,

        type,

        radius,

        latitude:
            currentLatitude,

        longitude:
            currentLongitude,

        createdAt:
            new Date()
            .toISOString()

    };


    locations.push(
        newLocation
    );


    saveLocations(
        locations
    );


    document
    .getElementById(
        "locationName"
    )
    .value = "";


    closeModal();


    checkLocations();

}


/* ==========================================
   INICIALIZAR
========================================== */

renderLocations();

updateStats();

startGPS();


</script>

</body>
</html>
