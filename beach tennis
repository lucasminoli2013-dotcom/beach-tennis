<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Beach Radar</title>

<style>

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, sans-serif;
    background: #07111f;
    color: white;
    min-height: 100vh;
}

/* HEADER */

header {
    background: #0c192b;
    border-bottom: 1px solid #20334d;
    padding: 18px;
}

.header {
    max-width: 900px;
    margin: auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    display: flex;
    align-items: center;
    gap: 12px;
}

.logo-icon {
    width: 45px;
    height: 45px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 12px;

    background: linear-gradient(
        135deg,
        #20d68a,
        #149fe3
    );

    font-size: 24px;
}

.logo h1 {
    font-size: 21px;
}

.logo p {
    color: #8da0b8;
    font-size: 12px;
    margin-top: 3px;
}

/* GPS */

.gps {
    display: flex;
    align-items: center;
    gap: 7px;

    color: #8da0b8;
    font-size: 13px;
}

.gps-dot {
    width: 9px;
    height: 9px;

    border-radius: 50%;

    background: #f59e0b;
}

.gps-dot.active {
    background: #20d68a;

    box-shadow:
        0 0 12px
        rgba(32,214,138,.8);
}

/* MAIN */

main {
    max-width: 900px;
    margin: auto;
    padding: 25px 16px 60px;
}

/* STATUS */

.status {
    background: #101e31;

    border: 1px solid #20334d;

    border-radius: 18px;

    padding: 25px;

    margin-bottom: 18px;
}

.status-label {
    color: #8da0b8;
    font-size: 12px;
    margin-bottom: 7px;
}

.status-title {
    font-size: 25px;
    font-weight: bold;
}

.status-text {
    color: #8da0b8;
    margin-top: 8px;
    font-size: 14px;
}

/* ACTIVE */

.active-box {
    display: none;

    margin-top: 20px;

    text-align: center;

    padding: 25px;

    border-radius: 15px;

    background: rgba(32,214,138,.08);

    border: 1px solid rgba(32,214,138,.3);
}

.active-box.show {
    display: block;
}

.active-icon {
    font-size: 55px;
    margin-bottom: 10px;
}

.active-box h2 {
    margin-bottom: 7px;
}

.active-box p {
    color: #8da0b8;
}

/* STATS */

.stats {
    display: grid;

    grid-template-columns:
        repeat(2, 1fr);

    gap: 14px;

    margin-bottom: 18px;
}

.stat {
    background: #101e31;

    border: 1px solid #20334d;

    border-radius: 16px;

    padding: 20px;
}

.number {
    color: #20d68a;

    font-size: 30px;

    font-weight: bold;
}

.label {
    color: #8da0b8;

    font-size: 13px;

    margin-top: 5px;
}

/* SECTION */

.section {
    background: #101e31;

    border: 1px solid #20334d;

    border-radius: 18px;

    padding: 22px;
}

.section-header {
    display: flex;

    justify-content: space-between;

    align-items: center;

    margin-bottom: 18px;

    gap: 10px;
}

.section-header h2 {
    font-size: 18px;
}

/* BUTTON */

button {
    border: none;

    border-radius: 10px;

    cursor: pointer;

    font-weight: bold;

    transition: .2s;
}

.primary {
    background: #20d68a;

    color: #061b11;

    padding: 12px 16px;
}

.primary:hover {
    background: #13b975;

    transform: translateY(-1px);
}

.secondary {
    background: #20334d;

    color: white;

    padding: 12px 16px;
}

/* LOCATIONS */

.locations {
    display: flex;

    flex-direction: column;

    gap: 12px;
}

.location {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 15px;

    padding: 16px;

    border-radius: 14px;

    background: #0b1727;

    border: 1px solid #20334d;
}

.location.active {
    border-color: #20d68a;

    background:
        rgba(32,214,138,.06);
}

.location-info {
    display: flex;

    align-items: center;

    gap: 12px;
}

.location-icon {
    width: 43px;
    height: 43px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 12px;

    background: #1b2b42;

    font-size: 20px;
}

.location-name {
    font-weight: bold;
}

.location-meta {
    color: #8da0b8;

    font-size: 12px;

    margin-top: 5px;
}

.distance {
    color: #20d68a;

    font-size: 13px;

    font-weight: bold;

    white-space: nowrap;
}

.remove {
    margin-top: 8px;

    background: transparent;

    color: #ef4444;

    border: 1px solid rgba(239,68,68,.3);

    padding: 6px 9px;

    font-size: 11px;
}

/* EMPTY */

.empty {
    text-align: center;

    padding: 35px;

    color: #8da0b8;
}

.empty-icon {
    font-size: 35px;

    margin-bottom: 8px;
}

/* MODAL */

.modal {
    position: fixed;

    inset: 0;

    display: none;

    align-items: center;

    justify-content: center;

    padding: 18px;

    background: rgba(0,0,0,.75);

    z-index: 100;
}

.modal.show {
    display: flex;
}

.modal-box {
    width: 100%;

    max-width: 450px;

    background: #101e31;

    border: 1px solid #263b57;

    border-radius: 18px;

    padding: 24px;
}

.modal-box h2 {
    margin-bottom: 20px;
}

label {
    display: block;

    color: #8da0b8;

    font-size: 13px;

    margin-bottom: 7px;
}

input,
select {
    width: 100%;

    padding: 13px;

    margin-bottom: 16px;

    border-radius: 10px;

    border: 1px solid #263b57;

    background: #081423;

    color: white;

    outline: none;
}

input:focus,
select:focus {
    border-color: #20d68a;
}

.modal-buttons {
    display: flex;

    gap: 10px;
}

.modal-buttons button {
    flex: 1;
}

/* MOBILE */

@media(max-width:600px) {

    .header {
        align-items: flex-start;
    }

    .gps {
        font-size: 11px;
    }

    .location {
        align-items: flex-start;
    }

    .distance {
        font-size: 12px;
    }

}

</style>
</head>

<body>

<header>

<div class="header">

<div class="logo">

<div class="logo-icon">
🏓
</div>

<div>

<h1>Beach Radar</h1>

<p>Jogadores perto de você</p>

</div>

</div>

<div class="gps">

<div
id="gpsDot"
class="gps-dot">
</div>

<span id="gpsText">
GPS aguardando
</span>

</div>

</div>

</header>


<main>

<!-- STATUS -->

<section class="status">

<div class="status-label">
STATUS ATUAL
</div>

<div
id="statusTitle"
class="status-title">

Aguardando localização...

</div>

<div
id="statusText"
class="status-text">

Permita o acesso à localização
para utilizar o Beach Radar.

</div>


<div
id="activeBox"
class="active-box">

<div class="active-icon">
🏓
</div>

<h2>
Você está no ponto!
</h2>

<p id="activeName">
</p>

</div>

</section>


<!-- ESTATÍSTICAS -->

<section class="stats">

<div class="stat">

<div
id="locationsCount"
class="number">

0

</div>

<div class="label">
Locais cadastrados
</div>

</div>


<div class="stat">

<div
id="activeCount"
class="number">

NÃO

</div>

<div class="label">
Você está em um ponto
</div>

</div>

</section>


<!-- LOCAIS -->

<section class="section">

<div class="section-header">

<h2>
📍 Pontos de encontro
</h2>

<button
class="primary"
onclick="openModal()">

+ Adicionar

</button>

</div>


<div
id="locations"
class="locations">

</div>

</section>

</main>


<!-- MODAL -->

<div
id="modal"
class="modal">

<div class="modal-box">

<h2>
Adicionar ponto
</h2>

<label>
Nome do local
</label>

<input
id="name"
type="text"
placeholder="Ex: Arena Central">


<label>
Tipo
</label>

<select id="type">

<option>Arena</option>

<option>Quadra</option>

<option>Praia</option>

<option>Clube</option>

</select>


<label>
Raio de presença
</label>

<input
id="radius"
type="number"
value="100"
min="20"
max="1000">


<div class="modal-buttons">

<button
class="secondary"
onclick="closeModal()">

Cancelar

</button>

<button
class="primary"
onclick="addLocation()">

Adicionar

</button>

</div>

</div>

</div>


<script>

/*
========================================
BEACH RADAR
========================================
*/

let userLat = null;
let userLon = null;

let activeLocation = null;


/*
========================================
STORAGE
========================================
*/

function getLocations() {

    try {

        return JSON.parse(
            localStorage.getItem(
                "beachRadar"
            )
        ) || [];

    } catch {

        return [];

    }

}


function saveLocations(data) {

    localStorage.setItem(
        "beachRadar",
        JSON.stringify(data)
    );

}


/*
========================================
DISTÂNCIA
========================================
*/

function calculateDistance(
    lat1,
    lon1,
    lat2,
    lon2
) {

    const R = 6371000;

    const dLat =
        (lat2 - lat1)
        * Math.PI / 180;

    const dLon =
        (lon2 - lon1)
        * Math.PI / 180;

    const a =
        Math.sin(dLat / 2) ** 2 +

        Math.cos(
            lat1 * Math.PI / 180
        ) *

        Math.cos(
            lat2 * Math.PI / 180
        ) *

        Math.sin(dLon / 2) ** 2;

    const c =
        2 *
        Math.atan2(
            Math.sqrt(a),
            Math.sqrt(1 - a)
        );

    return R * c;

}


/*
========================================
GPS
========================================
*/

function startGPS() {

    if (!navigator.geolocation) {

        setGPS(
            false,
            "GPS indisponível"
        );

        return;

    }


    navigator.geolocation.watchPosition(

        function(position) {

            userLat =
                position.coords.latitude;

            userLon =
                position.coords.longitude;


            setGPS(
                true,
                "GPS ativo"
            );


            checkLocations();

        },

        function() {

            setGPS(
                false,
                "Localização bloqueada"
            );


            document
                .getElementById(
                    "statusTitle"
                )
                .textContent =
                "Localização bloqueada";


            document
                .getElementById(
                    "statusText"
                )
                .textContent =
                "Permita a localização no navegador.";

        },

        {

            enableHighAccuracy: true,

            maximumAge: 5000,

            timeout: 15000

        }

    );

}


function setGPS(
    active,
    text
) {

    const dot =
        document.getElementById(
            "gpsDot"
        );

    const label =
        document.getElementById(
            "gpsText"
        );


    label.textContent = text;


    if (active) {

        dot.classList.add(
            "active"
        );

    } else {

        dot.classList.remove(
            "active"
        );

    }

}


/*
========================================
VERIFICAR PONTOS
========================================
*/

function checkLocations() {

    if (
        userLat === null ||
        userLon === null
    ) {

        return;

    }


    const locations =
        getLocations();


    activeLocation = null;


    for (
        const location
        of locations
    ) {

        const meters =
            calculateDistance(

                userLat,
                userLon,

                location.latitude,
                location.longitude

            );


        if (
            meters <= location.radius
        ) {

            activeLocation = {

                ...location,

                distance: meters

            };

            break;

        }

    }


    updateScreen();

}


/*
========================================
ATUALIZAR TELA
========================================
*/

function updateScreen() {

    const title =
        document.getElementById(
            "statusTitle"
        );

    const text =
        document.getElementById(
            "statusText"
        );

    const box =
        document.getElementById(
            "activeBox"
        );


    if (activeLocation) {

        title.textContent =
            "Você está jogando!";


        text.textContent =
            "Ponto de encontro detectado.";


        box.classList.add(
            "show"
        );


        document
            .getElementById(
                "activeName"
            )
            .textContent =

            activeLocation.name
            +
            " • "
            +
            Math.round(
                activeLocation.distance
            )
            +
            " metros";

    } else {

        title.textContent =
            "Nenhum ponto próximo";


        text.textContent =
            "Nenhum ponto foi encontrado perto de você.";


        box.classList.remove(
            "show"
        );

    }


    renderLocations();

    updateStats();

}


/*
========================================
ESTATÍSTICAS
========================================
*/

function updateStats() {

    const locations =
        getLocations();


    document
        .getElementById(
            "locationsCount"
        )
        .textContent =
        locations.length;


    document
        .getElementById(
            "activeCount"
        )
        .textContent =
        activeLocation
        ? "SIM"
        : "NÃO";

}


/*
========================================
RENDERIZAR
========================================
*/

function renderLocations() {

    const container =
        document.getElementById(
            "locations"
        );


    const locations =
        getLocations();


    if (
        locations.length === 0
    ) {

        container.innerHTML = `

            <div class="empty">

                <div class="empty-icon">
                    📍
                </div>

                Nenhum ponto cadastrado.

                <br>

                Clique em
                "+ Adicionar"
                para criar um.

            </div>

        `;

        return;

    }


    container.innerHTML = "";


    locations.forEach(
        location => {

            let meters = null;

            let isActive = false;


            if (
                userLat !== null &&
                userLon !== null
            ) {

                meters =
                    calculateDistance(

                        userLat,
                        userLon,

                        location.latitude,
                        location.longitude

                    );


                isActive =
                    meters <=
                    location.radius;

            }


            let distanceText =
                "Local salvo";


            if (meters !== null) {

                if (
                    meters >= 1000
                ) {

                    distanceText =
                        (
                            meters / 1000
                        ).toFixed(1)
                        +
                        " km";

                } else {

                    distanceText =
                        Math.round(
                            meters
                        )
                        +
                        " m";

                }

            }


            const div =
                document.createElement(
                    "div"
                );


            div.className =
                "location";


            if (isActive) {

                div.classList.add(
                    "active"
                );

            }


            div.innerHTML = `

                <div class="location-info">

                    <div class="location-icon">
                        📍
                    </div>

                    <div>

                        <div class="location-name">

                            ${escapeHTML(
                                location.name
                            )}

                        </div>

                        <div class="location-meta">

                            ${escapeHTML(
                                location.type
                            )}

                            • Raio:
                            ${location.radius} m

                        </div>

                        <button
                            class="remove"
                            onclick="removeLocation('${location.id}')">

                            Remover

                        </button>

                    </div>

                </div>

                <div class="distance">

                    ${distanceText}

                </div>

            `;


            container.appendChild(
                div
            );

        }
    );

}


/*
========================================
PROTEÇÃO
========================================
*/

function escapeHTML(text) {

    return String(text)

        .replaceAll(
            "&",
            "&amp;"
        )

        .replaceAll(
            "<",
            "&lt;"
        )

        .replaceAll(
            ">",
            "&gt;"
        )

        .replaceAll(
            '"',
            "&quot;"
        )

        .replaceAll(
            "'",
            "&#039;"
        );

}


/*
========================================
MODAL
========================================
*/

function openModal() {

    document
        .getElementById(
            "modal"
        )
        .classList
        .add("show");

}


function closeModal() {

    document
        .getElementById(
            "modal"
        )
        .classList
        .remove("show");

}


/*
========================================
ADICIONAR LOCAL
========================================
*/

function addLocation() {

    if (
        userLat === null ||
        userLon === null
    ) {

        alert(
            "Ative a localização primeiro."
        );

        return;

    }


    const name =
        document
            .getElementById(
                "name"
            )
            .value
            .trim();


    const type =
        document
            .getElementById(
                "type"
            )
            .value;


    const radius =
        Number(
            document
                .getElementById(
                    "radius"
                )
                .value
        );


    if (!name) {

        alert(
            "Digite o nome do local."
        );

        return;

    }


    if (
        radius < 20 ||
        radius > 1000
    ) {

        alert(
            "O raio deve estar entre 20 e 1000 metros."
        );

        return;

    }


    const locations =
        getLocations();


    /*
    Verificar locais próximos
    */

    for (
        const location
        of locations
    ) {

        const meters =
            calculateDistance(

                userLat,
                userLon,

                location.latitude,
                location.longitude

            );


        if (
            meters < 50
        ) {

            alert(
                "Já existe um ponto próximo: "
                +
                location.name
            );

            return;

        }

    }


    const newLocation = {

        id:
            crypto.randomUUID(),

        name:
            name,

        type:
            type,

        radius:
            radius,

        latitude:
            userLat,

        longitude:
            userLon,

        createdAt:
            new Date()
            .toISOString()

    };


    locations.push(
        newLocation
    );


    saveLocations(
        locations
    );


    document
        .getElementById(
            "name"
        )
        .value = "";


    closeModal();


    checkLocations();

}


/*
========================================
REMOVER
========================================
*/

function removeLocation(id) {

    const locations =
        getLocations();


    const updated =
        locations.filter(
            location =>
                location.id !== id
        );


    saveLocations(
        updated
    );


    checkLocations();

}


/*
========================================
INICIAR
========================================
*/

renderLocations();

updateStats();

startGPS();

</script>

</body>
</html>
